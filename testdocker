# Fast-build Dockerfile for Traefik Dynamic Config Editor (dev/local use)
# Optimized for Raspberry Pi 4 with local image caching

# Use ARGs to allow switching between remote and local images
ARG NODE_IMAGE=node:20-alpine
ARG GOLANG_IMAGE=golang:1.24-alpine
ARG ALPINE_IMAGE=alpine:3.18

# Stage 1: Build React frontend (dev-optimized)
FROM ${NODE_IMAGE} AS frontend-dev
WORKDIR /src/frontend/editorfront

# Install dependencies only if package files change
COPY frontend/editorfront/package.json frontend/editorfront/package-lock.json ./

# Optimize npm for Pi 4 (reduce parallelism, skip optional deps)
RUN npm ci --legacy-peer-deps --prefer-offline --no-audit \
    --omit=optional --maxsockets=2 --no-fund

# Copy source files
COPY frontend/editorfront/. ./

# Fast dev build (no minification, source maps enabled)
RUN npm run build -- --mode development

# Stage 2: Build Go backend (dev-optimized)
FROM ${GOLANG_IMAGE} AS backend-dev
WORKDIR /src/backend

# Install build dependencies
RUN apk add --no-cache git ca-certificates

# Download dependencies only if go.mod changes
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Copy backend source
COPY backend/*.go ./

# Fast build (no CGO, debug symbols for dev)
RUN CGO_ENABLED=0 go build -gcflags="all=-N -l" -o traefik-dynamic-editor

# Stage 3: Minimal runtime image
FROM ${ALPINE_IMAGE}

# Install runtime dependencies
RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app/backend

# Copy binaries and static files
COPY --from=backend-dev /src/backend/traefik-dynamic-editor .
COPY --from=frontend-dev /src/frontend/editorfront/dist /app/frontend/editorfront/dist

# Create directories for mounted configs
RUN mkdir -p /app/dynamic /app/config && \
    chown -R appuser:appuser /app

USER appuser

EXPOSE 8010

ENV PORT=8010 \
    DYNAMIC_CONFIG_PATH=../dynamic/dynamic.yml \
    TRAEFIK_CONFIG_PATH=../config/traefik.yml \
    GIN_MODE=debug

CMD ["./traefik-dynamic-editor"]